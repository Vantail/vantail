#!/usr/bin/env bash
# Build the runtime for every platform this machine can reach.
#
# Three of the five, from a Mac with Docker: macOS natively, both Linux
# architectures in containers. Windows needs Windows, so a full release still
# goes through CI.
#
#   scripts/build-platforms                  # into dist-runtime/
#   scripts/build-platforms out-dir
#
# The result is the layout scripts/build-platform-packages.mjs expects: one
# directory per Rust target triple.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
out=$(cd "$(dirname "${1:-$root/dist-runtime}")" && pwd)/$(basename "${1:-dist-runtime}")
work=${VANTAIL_LINUX_WORK:-${TMPDIR:-/tmp}/vantail-linux}

say() { printf '\n== %s\n' "$1"; }

mkdir -p "$out"/{aarch64-apple-darwin,aarch64-unknown-linux-gnu,x86_64-unknown-linux-gnu}

say "macOS arm64"
cargo build --release
cp "$root/target/release/vantail-runtime" "$out/aarch64-apple-darwin/"

# A copy, so the containers' target directories never meet the host's.
mkdir -p "$work/src"
rsync -a --delete --exclude node_modules --exclude target --exclude .git \
  --exclude build --exclude .vantail --exclude dist "$root/" "$work/src/"

docker build -q -t vantail-linux "$root/scripts/linux" >/dev/null

say "Linux arm64"
docker run --rm -v "$work/src":/work -v "$work/linux-arm64":/target -w /work \
  -e CARGO_TARGET_DIR=/target vantail-linux cargo build --release
docker run --rm -v "$work/linux-arm64":/t -v "$out":/o vantail-linux \
  cp /t/release/vantail-runtime /o/aarch64-unknown-linux-gnu/

say "Linux x86_64 (emulated, slow)"
docker build --platform linux/amd64 -q -t vantail-linux-amd64 "$root/scripts/linux" >/dev/null
docker run --rm --platform linux/amd64 -v "$work/src":/work -v "$work/linux-amd64":/target -w /work \
  -e CARGO_TARGET_DIR=/target vantail-linux-amd64 cargo build --release
docker run --rm --platform linux/amd64 -v "$work/linux-amd64":/t -v "$out":/o vantail-linux-amd64 \
  cp /t/release/vantail-runtime /o/x86_64-unknown-linux-gnu/

say "built"
for dir in "$out"/*/; do
  binary="$dir/vantail-runtime"
  [ -f "$binary" ] && printf '  %-28s %s\n' "$(basename "$dir")" "$(file -b "$binary" | cut -c1-40)"
done
echo
echo "Windows is not here: it needs Windows. Package these with"
echo "  node scripts/build-platform-packages.mjs --binaries $out --out dist-packages"
