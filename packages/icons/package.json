{
  "name": "@vantail/icons",
  "version": "0.1.25",
  "description": "First-party Lucide-powered icons for Vantail applications (vanilla + React).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vantail/vantail.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/Vantail/vantail",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lucide": "^1.48.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.0"
  }
}
